{
  "manifest_version": 3,
  "name": "RopeDrop Helper",
  "version": "1.1.0",
  "description": "Adds a clean Lightning Lane and Virtual Queue overlay on top of My Disney Experience, and connects your session to the RopeDrop dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open RopeDrop overlay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://disneyworld.disney.go.com/*",
        "https://disneyland.disney.go.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://disneyworld.disney.go.com/*",
    "https://disneyland.disney.go.com/*",
    "https://*.disney.go.com/*",
    "https://ropedrop.williamsdigital.io/*",
    "https://ropedrop-app.vercel.app/*"
  ],
  "permissions": ["cookies"]
}
