{
  "manifest_version": 3,
  "name": "RopeDrop Helper",
  "version": "2.0.0",
  "description": "Adds a one-tap RopeDrop launcher to My Disney Experience and disneyland.com — opens live wait times, crowd forecast, and Lightning Lane quick-links.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open RopeDrop",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://disneyworld.disney.go.com/*",
        "https://disneyland.disney.go.com/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": []
}
