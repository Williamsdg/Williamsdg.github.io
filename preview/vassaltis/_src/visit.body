Visit | visit
<main id="main">
  <section class="page-head" style="border-bottom:0;padding-bottom:0">
    <div class="wrap">
      <div class="grid">
        <div>
          <p class="eyebrow"><span class="hex"></span>Visit the winery · Vourvoulos, Santorini</p>
          <h1 class="d1">A taste of the <span class="i">extraordinary.</span></h1>
        </div>
        <div>
          <p class="lede" style="margin-bottom:24px">Learn the local varieties and the island’s terroir in a tasting room that looks out over the vines, then stay for lunch or dinner.</p>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn" href="#book">Choose an experience</a>
            <a class="btn ghost" href="#dining">Lunch &amp; dinner</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap" style="margin-top:clamp(40px,5vw,72px)">
    <div class="frame" style="aspect-ratio:21/9"><img src="img/tasting-room.jpg" alt="The Vassaltis tasting room: long tables, a bar and open doors to the vineyard" width="2000" height="1333"></div>
  </div>

  <!-- practical -->
  <section class="section tight dark" style="margin-top:clamp(48px,6vw,88px)">
    <div class="wrap">
      <div class="info-grid">
        <div>
          <p class="eyebrow">Opening hours</p>
          <h3>11:00–20:00</h3>
          <p class="muted small"><span class="confirm">Seasonal opening dates to confirm</span></p>
        </div>
        <div>
          <p class="eyebrow">Find us</p>
          <h3>Vourvoulos–Oia peripheral road</h3>
          <p class="small" style="margin:0 0 10px">847 00 Santorini, Greece</p>
          <a class="arrow" href="https://www.google.com/maps/search/?api=1&query=Vassaltis+Vineyards+Santorini" target="_blank" rel="noopener">Directions ↗</a>
        </div>
        <div>
          <p class="eyebrow">Talk to the team</p>
          <h3><a href="tel:+302286022211" style="text-decoration:none">+30 22860 22211</a></h3>
          <p class="small" style="margin:0"><a href="mailto:info@vassaltis.com">info@vassaltis.com</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- experiences -->
  <section id="book" style="scroll-margin-top:90px">
    <div class="wrap">
      <div style="padding-top:clamp(64px,8vw,112px)">
        <p class="eyebrow">Wine experiences</p>
        <h2 class="d2">In the tasting room</h2>
      </div>
      <div id="xp-wine"></div>
    </div>
  </section>

  <section id="dining" style="scroll-margin-top:90px">
    <div class="wrap">
      <div style="padding-top:clamp(64px,8vw,112px)">
        <p class="eyebrow">Lunch &amp; dinner</p>
        <h2 class="d2">At the table</h2>
        <p class="lede" style="margin-top:18px">A romantic dinner for two or a small gathering of friends. The oenologists will walk you through choosing the right bottle.</p>
      </div>
      <div id="xp-dine"></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="info-grid" style="border-top-color:var(--line)">
        <div style="border-color:var(--line)">
          <p class="eyebrow">Dietary needs</p>
          <p class="small" style="margin:0">Allergies and dietary restrictions can be accommodated with advance notice. Mention them when you book, or call the winery.</p>
        </div>
        <div style="border-color:var(--line)">
          <p class="eyebrow">Changes &amp; cancellations</p>
          <p class="small" style="margin:0 0 10px">Handled through your i-host confirmation or by phone.</p>
          <span class="confirm">Policy wording to confirm</span>
        </div>
        <div style="border-color:var(--line)">
          <p class="eyebrow">Accessibility</p>
          <p class="small" style="margin:0 0 10px">Tell us what you need and we’ll plan the visit around it.</p>
          <span class="confirm">Step-free access to confirm</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(28px,4vw,64px)">
      <a href="athens.html" style="text-decoration:none;display:block">
        <div class="frame" style="aspect-ratio:3/2;margin-bottom:22px"><img src="img/athens-lounge.jpg" alt="The lounge at Vassaltis Downtown, Athens" loading="lazy" width="2000" height="1334"></div>
        <p class="eyebrow">In Athens</p>
        <h3 class="d3">Vassaltis Downtown, Psyrri</h3>
        <p class="small muted" style="margin:10px 0 16px">Private tastings for up to 12 and wine dinners for up to 10.</p>
        <span class="arrow">Enquire in Athens</span>
      </a>
      <a href="https://www.thevasilicos.com/" target="_blank" rel="noopener" style="text-decoration:none;display:block">
        <div class="frame" style="aspect-ratio:3/2;margin-bottom:22px"><img src="img/glass-sky.jpg" alt="A glass of Vassaltis wine raised against the sky" loading="lazy" width="2000" height="1500"></div>
        <p class="eyebrow">Stay with us</p>
        <h3 class="d3">The Vasilicos</h3>
        <p class="small muted" style="margin:10px 0 16px">Our sister hotel, a separate property with its own reservations.</p>
        <span class="arrow">thevasilicos.com ↗</span>
      </a>
    </div>
  </section>
</main>
